# Copy this file to .env and fill in your values.

# --- LLM (required for 'ai' mode) ---
# Use "openai/gpt-4o-mini", "gemini/gemini-2.0-flash", "anthropic/claude-3-5-haiku-20241022"
# "openrouter/google/gemma-3-27b-it:free" hoac "ollama/qwen2.5" cho model local (khong can key).
LLM_PROVIDER=openai/gpt-4o-mini
OPENAI_API_KEY=sk-...
# Dung khi provider la openrouter/...
OPENROUTER_API_KEY=sk-or-v1-...
# Dung khi provider la gemini/... hoac google/...
GEMINI_API_KEY=
# Dung khi provider la anthropic/...
ANTHROPIC_API_KEY=

# --- Browser ---
# Set to "false" to show the browser window (useful for debugging)
HEADLESS=true
PAGE_TIMEOUT=30000

# --- Output ---
OUTPUT_DIR=output

# --- Chunking (AI mode) ---
# Tokens per chunk sent to the LLM. Smaller = cheaper per call.
CHUNK_TOKEN_THRESHOLD=3000
