# --- LLM provider -----------------------------------------------------------
# Format: "vendor/model-name"  (LiteLLM convention)
LLM_PROVIDER=gemini/gemini-2.0-flash

# --- API keys (set ONLY the one matching your provider) ---------------------
# Each provider reads its own env variable — you don't need to fill them all.

# OpenAI  → https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini (free tier) → https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Groq (free tier, very fast) → https://console.groq.com
GROQ_API_KEY=gsk_...

# Cohere → https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...

# Anthropic → https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local, no key needed) — just set the provider:
# LLM_PROVIDER=ollama/qwen2.5

# --- Browser ---
# Set to "false" to show the browser window (useful for debugging)
HEADLESS=true
PAGE_TIMEOUT=30000

# --- Output ---
OUTPUT_DIR=output

# --- Chunking (AI mode) ---
# Tokens per chunk sent to the LLM. Smaller = cheaper per call.
CHUNK_TOKEN_THRESHOLD=3000
